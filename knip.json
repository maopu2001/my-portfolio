{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found,global-error,route,template,default,opengraph-image,twitter-image,icon,apple-icon,sitemap,robots,manifest}.{ts,tsx}",
    "components/ui/**/*.{ts,tsx}"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "tw-animate-css",
    "shadcn",
    "tailwindcss"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "types": "off",
    "nsTypes": "off"
  }
}
